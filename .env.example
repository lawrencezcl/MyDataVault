# Server Configuration
PORT=3001
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
FRONTEND_URL=http://localhost:5173

# IPFS Configuration
IPFS_HOST=ipfs.infura.io
IPFS_PORT=5001
IPFS_PROTOCOL=https
IPFS_AUTH=your-infura-project-secret

# Polkadot Configuration
POLKADOT_WS_URL=wss://shibuya-rpc.dwellir.com
# For mainnet, use: wss://rpc.astar.network

# Database Configuration (for future use)
DATABASE_URL=postgresql://user:password@localhost:5432/mydatavault

# Encryption Configuration
ENCRYPTION_KEY=your-encryption-key-change-this-in-production

# Web2 Integration Keys (for future use)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret