{
  "version": 2,
  "rewrites": [
    { "source": "/api/ipfs/upload", "destination": "/api/ipfs/upload-polkadot.js" },
    { "source": "/api/auth/wallet", "destination": "/api/auth/wallet.js" },
    { "source": "/api/blockchain/store", "destination": "/api/blockchain/store.js" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/assets/(.*)", "destination": "/dist/assets/$1" },
    { "source": "/favicon.svg", "destination": "/dist/favicon.svg" },
    { "source": "/(.*)", "destination": "/dist/index.html" }
  ],
  "functions": {
    "api/ipfs/upload-polkadot.js": {
      "maxDuration": 30
    },
    "api/auth/wallet.js": {
      "maxDuration": 10
    },
    "api/blockchain/store.js": {
      "maxDuration": 15
    }
  },
  "env": {
    "NODE_ENV": "production",
    "JWT_SECRET": "0b4a93420a6f31368a64a96554616387cac18b7fb71f553e3aa34a1339f7f3249b194178ab299524fe0b3b8b584027959e10d7682068ea2bd0e84310b86b7aef",
    "IPFS_HOST": "ipfs.w3auth.io",
    "IPFS_PORT": "443",
    "IPFS_PROTOCOL": "https",
    "IPFS_AUTH": "Bearer polkadot-gateway",
    "POLKADOT_WS_URL": "wss://rpc.polkadot.io"
  }
}